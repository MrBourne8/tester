APP_NAME="Тестория"
APP_TAGLINE="Территория создания и прохождения тестов"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
# Если Тестория в подпапке (например https://spo-progress.ru/testoria/), укажите префикс:
# APP_BASE_PATH=/testoria
# APP_BASE_PATH=
# Публичный адрес для доступа учеников через интернет (туннель / домен).
# Пример: https://xxxx.trycloudflare.com  или  https://tests.college.ru
# PUBLIC_BASE_URL=
APP_KEY=

# SSO из СПО-ПРОГРЕСС (панель преподавателя → Тестория).
# Если пусто — секрет читается/создаётся в ../.spo_testoria_sso_secret
# SPO_SSO_SECRET=

# Базовый URL СПО-ПРОГРЕСС (для редиректа с закладки Тестории на вход).
# Пример: https://spo-progress.ru
# SPO_BASE_URL=https://spo-progress.ru


# OSPanel MySQL обычно слушает 127.0.1.30, не 127.0.0.1
DB_HOST=127.0.1.30
DB_PORT=3306
DB_DATABASE=unitest
DB_USERNAME=root
DB_PASSWORD=

# Порт 8080 в OSPanel часто занят другим доменом — по умолчанию 8090
SERVER_BIND_HOST=127.0.0.1
SERVER_PORT=8090
