APP_NAME="Тестория"
APP_TAGLINE="Территория создания и прохождения тестов"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
# Публичный адрес для доступа учеников через интернет (туннель / домен).
# Пример: https://xxxx.trycloudflare.com  или  https://tests.college.ru
# PUBLIC_BASE_URL=
APP_KEY=

# OSPanel MySQL обычно слушает 127.0.1.30, не 127.0.0.1
DB_HOST=127.0.1.30
DB_PORT=3306
DB_DATABASE=unitest
DB_USERNAME=root
DB_PASSWORD=

# Порт 8080 в OSPanel часто занят другим доменом — по умолчанию 8090
SERVER_BIND_HOST=127.0.0.1
SERVER_PORT=8090
