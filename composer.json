{
  "name": "unitest/app",
  "description": "UniTest — кроссплатформенная система тестирования",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "UniTest\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniTest\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
