{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniTest Player",
  "version": "0.1.0",
  "identifier": "local.unitest.player",
  "build": {
    "beforeDevCommand": "npm run build:tauri-frontend",
    "beforeBuildCommand": "npm run build:tauri-frontend",
    "frontendDist": "../dist/tauri-frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UniTest Player",
        "width": 920,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {}
}
